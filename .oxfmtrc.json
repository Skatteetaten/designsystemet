{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "bracketSameLine": false,
  "ignorePatterns": [
    "/dist",
    "/coverage",
    "apps/ds-playground/coverage/",
    "/.idea",
    "/.scannerwork",
    "/.nyc_output",
    "/.vscode",
    "apps/ds-playground/.nyc_output",
    "**/*stats.html",
    "/.nx/cache",
    "/.nx/workspace-data",
    ".nx/self-healing",
    "**/*.scss.d.ts"
  ],
  "jsdoc": false,
  "jsxSingleQuote": false,
  "overrides": [
    {
      "files": ["*.mdx"],
      "options": {
        "proseWrap": "never"
      }
    }
  ],
  "printWidth": 80,
  "semi": true,
  "singleQuote": true,
  "sortPackageJson": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "useTabs": false
}
